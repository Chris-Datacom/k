{
  "name": "K",
  "scopeName": "source.k",
  "fileTypes": [
    "k"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.k",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.k",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.k",
          "match": "\\\\(?:n|r|t|\\\\|\"|')"
        }
      ]
    },
    "characters": {
      "name": "constant.character.k",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.k",
          "match": "\\\\(?:n|r|t|\\\\|')"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.k",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.k",
          "match": "\\b(?:if|else|while|return|let)\\b"
        },
        {
          "name": "keyword.other.k",
          "match": "\\b(?:struct|extern|true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.k",
          "match": "\\b(?:int|char|void|u8|u16|u32|u64|i32|i64|bool)\\b"
        },
        {
          "name": "storage.modifier.k",
          "match": "\\bvolatile\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.k",
          "match": "==|!=|<=|>=|<<|>>|[+*/=<>&|^~.-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.k",
          "match": "[(),]"
        },
        {
          "name": "punctuation.section.block.k",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.k",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.accessor.k",
          "match": "\\."
        },
        {
          "name": "punctuation.terminator.k",
          "match": ";"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.k"
            },
            "2": {
              "name": "entity.name.type.k"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^;{}]*\\)\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.k"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.k"
            }
          }
        }
      ]
    }
  }
}
